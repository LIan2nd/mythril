# MYTHRIL app env template. Copy to web/.env.local (git-ignored) and edit.
# Resolution order in code: DB_URL > DATABASE_URL > built-in local fallback.

# --- [A] local Postgres (current setup) ---
DB_URL=postgresql://mythril:***@localhost:5432/mythril
DB_SSL=disable

# --- [B] Supabase / external Postgres (same key, just change value) ---
# DB_URL=postgresql://postgres.<ref>:***@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# DB_SSL=require
# transaction pooler :6543 → keep/append ?pgbouncer=true (handled in client)

# Vercel: configure DB_URL + DB_SSL as project Environment Variables
# (Vercel doesn't read files from the repo). No NEXT_PUBLIC_* vars exist —
# the UI talks to same-origin /api routes.

# COOKIE_SECURE=1 force Secure; leave unset: Secure only on Vercel, http://localhost works.

# Auth
# SESSION_SECRET=long-random-string   # session cookie signing key
# COOKIE_SECURE=                   # empty=auto (Vercel only), 1 force, 0 disable
