# =============================================================================
# MYTHRIL env — pick ONE database mode. Copied to .env, read by docker compose.
#
# MODE A — local Postgres managed by Docker Compose (default):
#   Keep COMPOSE_PROFILES=local-db and DATABASE_URL below (points at the "db"
#   service over the compose network). From OUTSIDE compose (psql, DBeaver,
#   local dev) the same container is reachable at localhost:5433.
#
# MODE B — Supabase / any external Postgres:
#   Set COMPOSE_PROFILES= (empty) so no local container starts, then paste the
#   Supabase DSN (Settings → Database → Connection string; session pooler or
#   direct IPv4). Keep ?sslmode=require or set DB_SSL=require.
# =============================================================================
COMPOSE_PROFILES=local-db

# MODE A:
DATABASE_URL=postgresql://mythril:[email protected]:5432/mythril
DB_SSL=disable

# MODE B (Supabase example — comment out the MODE A pair, uncomment this):
# DATABASE_URL=postgresql://postgres.yourproject:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# DB_SSL=require

# --- Local Postgres container (used only in MODE A) ------------------------
POSTGRES_USER=mythril
POSTGRES_PASSWORD=mythril
POSTGRES_DB=mythril
POSTGRES_PORT=5433

# --- Web app ----------------------------------------------------------------
# Host port the dashboard is published on (container listens on 3000).
APP_PORT=7111
NODE_ENV=production
